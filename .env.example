# SmartFarm AI - Environment Variables
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/smartfarm

# AI
GROQ_API_KEY=your_groq_api_key_here

# Weather (OpenWeatherMap - free tier works)
WEATHER_API_KEY=your_openweathermap_api_key_here
WEATHER_API_BASE=https://api.openweathermap.org/data/2.5

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# App Settings
APP_ENV=development
APP_SECRET_KEY=change_this_to_a_random_secret_key
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,null

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO
